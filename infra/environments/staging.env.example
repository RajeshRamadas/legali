# Copy to staging.env, keep it private, and replace every blank/invalid value.
# This template intentionally fails preflight until operator settings are supplied.
APP_ENV=staging
DATABASE_URL=
JWT_SECRET=
STAFF_MFA_ENCRYPTION_KEY=
STAFF_REQUIRE_ADMIN_MFA=true
LOGIN_CODE_DEV_MODE=false
PAYMENTS_TEST_MODE=false
RERA_SAMPLE_WHEN_EMPTY=false
PUBLIC_SITE_URL=https://staging.your-domain.invalid
CORS_ORIGINS=https://staging.your-domain.invalid
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Enable the worker only after test credentials/destinations and delivery policy are verified.
NOTIFY_WORKER_ENABLED=false
# Enable customer/staff support notices only after verifying delivery policy and recipients.
SUPPORT_REPLY_NOTIFICATIONS_ENABLED=false
SUPPORT_DEADLINE_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Staging permits only rzp_test_ credentials, with a separate test webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Empty S3 settings use private local storage; attach a durable volume and test backups.
LOCAL_STORAGE_DIR=/data/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
BLOG_AGENT_ENABLED=false
CHAT_RETENTION_ENABLED=false
