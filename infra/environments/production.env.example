# Copy to production.env, keep it private, and replace every blank/invalid value.
# Do not reuse staging signing/encryption keys, databases, buckets or provider credentials.
APP_ENV=production
DATABASE_URL=
JWT_SECRET=
STAFF_MFA_ENCRYPTION_KEY=
STAFF_REQUIRE_ADMIN_MFA=true
LOGIN_CODE_DEV_MODE=false
PAYMENTS_TEST_MODE=false
RERA_SAMPLE_WHEN_EMPTY=false
PUBLIC_SITE_URL=https://your-domain.invalid
CORS_ORIGINS=https://your-domain.invalid
# Optional one-time bootstrap. Remove BOTH after the first administrator is established.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Enable this or configure a separate notification worker after delivery verification.
NOTIFY_WORKER_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Production permits only rzp_live_ credentials, with a separate live webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOCAL_STORAGE_DIR=/data/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
BLOG_AGENT_ENABLED=false
# Remains opt-in after legal retention review; see privacy-and-retention.md.
CHAT_RETENTION_ENABLED=false
