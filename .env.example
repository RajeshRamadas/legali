# Copy to infra/.env (docker compose reads it from there) and change every value.
POSTGRES_DB=homexo
POSTGRES_USER=homexo_app
POSTGRES_PASSWORD=change-this-local-password
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
# Required when APP_ENV is not development: a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# First staff admin, created only when no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=admin@homexo.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
# AI chat assistant (optional). Without a key the chat uses its built-in rule-based answers.
ANTHROPIC_API_KEY=
# Property verification agent. Keys stay server-side; never use NEXT_PUBLIC_ names.
# Supports anthropic (default) or openai (including trusted HTTPS OpenAI-compatible endpoints).
# With anthropic, extraction uses claude-sonnet-5-5 (reads scanned page images) and comparison/legal screening
# uses claude-opus-5-5 unless overridden below. VERIFICATION_LLM_MODEL sets one model for both steps
# (needed for openai, which defaults to gpt-4.1-mini).
# The key falls back to ANTHROPIC_API_KEY when the provider is anthropic.
VERIFICATION_LLM_PROVIDER=anthropic
VERIFICATION_LLM_MODEL=
VERIFICATION_EXTRACT_MODEL=
VERIFICATION_COMPARE_MODEL=
VERIFICATION_SEND_PAGE_IMAGES=true
VERIFICATION_LLM_API_KEY=
VERIFICATION_LLM_BASE_URL=https://api.openai.com/v1
# Docker includes English, Hindi and Kannada OCR packs. Use eng+hin+kan for mixed scans.
VERIFICATION_OCR_LANGUAGES=eng+hin+kan
CHAT_MODEL=claude-haiku-5-5
# Video meetings (optional, see docs/meetings.md). Without Google, staff paste a Meet link.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_USER=
GOOGLE_CALENDAR_ID=primary
MEETING_TIMEZONE=Asia/Kolkata
# Without WhatsApp, meeting invites and reminders stay queued on the ticket.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PUBLIC_SITE_URL=http://localhost:3000
